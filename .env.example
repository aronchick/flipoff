# Copy to .env and edit:  cp .env.example .env
#
# Required. Anything that can write to the display needs this.
#   openssl rand -hex 32
AUTH_TOKEN=

# Host port to publish the kiosk on.
PORT=8080

# Cosmetic only: what the OpenAPI `servers` block advertises, so generated
# clients need no base-URL configuration. Set it to however you actually
# reach the box, e.g. http://kiosk.local:8080
PUBLIC_BASE_URL=http://localhost:8080
