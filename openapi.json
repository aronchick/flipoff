{
  "components": {
    "schemas": {
      "BrightnessPatch": {
        "description": "Absolute or relative change to the full-screen image brightness.",
        "examples": [
          {
            "brightness": 0.4
          },
          {
            "delta": -0.1
          }
        ],
        "properties": {
          "brightness": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.02,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Brightness"
          },
          "delta": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": -1.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Delta"
          }
        },
        "title": "BrightnessPatch",
        "type": "object"
      },
      "DisplayPatch": {
        "description": "One-call switch of what the TV is showing.",
        "examples": [
          {
            "mode": "board"
          },
          {
            "image": "logo-6251cafa.svg"
          },
          {
            "url": "https://example.com/animation.gif"
          },
          {
            "cycle": "next"
          }
        ],
        "properties": {
          "cycle": {
            "anyOf": [
              {
                "enum": [
                  "next",
                  "prev"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cycle"
          },
          "image": {
            "anyOf": [
              {
                "maxLength": 300,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image"
          },
          "mode": {
            "anyOf": [
              {
                "enum": [
                  "board",
                  "gif"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mode"
          },
          "url": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "title": "DisplayPatch",
        "type": "object"
      },
