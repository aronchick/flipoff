    "/api/display": {
      "post": {
        "description": "Switch mode and/or image in one call.\n\nPUT /api/state can already do this, but only by round-tripping the whole\ndocument, so a caller that just wants \"show the logo\" has to fetch, mutate\nand repost every quote -- and races anyone editing them. Accepts a gallery\nfilename, a direct URL, or a relative cycle through the gallery.",
        "operationId": "set_display_api_display_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DisplayPatch"
              }
            }
